{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "isolatedModules": true,
    "lib": ["ES2022"], "skipLibCheck": true, "types": ["node"], "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
